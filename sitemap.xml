<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
Hand-written on purpose: jekyll-sitemap would walk everything sitting on the
gh-pages branch, which means the 30 archived version directories. Only the
current site belongs here, so we filter on:
  - ".x/"        the archived documentation of past releases, which would
                 compete with the current docs in search results
  - "/others/"   leftovers kept on gh-pages
{%- endcomment -%}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in site.pages -%}
  {%- assign url = page.url -%}
  {%- unless url contains '.x/'
          or url contains '/others/'
          or url contains 'sitemap.xml'
          or url contains 'robots.txt'
          or url contains 'feed.xml'
          or url contains '.xml'
          or url contains '.js'
          or url contains '.css' -%}
    {%- assign clean = url | replace: 'index.html', '' -%}
  <url>
    <loc>{{ clean | prepend: site.url | xml_escape }}</loc>
  </url>
  {%- endunless -%}
{%- endfor %}
</urlset>
